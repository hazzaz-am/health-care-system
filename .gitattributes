# Normalize line endings to LF in the repository regardless of the host OS.
# Without this, core.autocrlf=true (the Windows default) rewrites files to CRLF
# on checkout, which then fails `prettier --check` since Prettier emits LF.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Keep the lockfile byte-stable so installs are reproducible.
pnpm-lock.yaml -text
